rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the known profiles exist, and each one holds a bounded block of progress.
    // Keep this list in step with PROFILES in assets/js/store.js.
    match /profiles/{profile} {
      allow get: if profile in ['alice', 'raquel', 'marina', 'japolo'];
      allow create, update: if profile in ['alice', 'raquel', 'marina', 'japolo']
        && request.resource.data.keys().hasOnly(['progress'])
        && request.resource.data.progress is string
        && request.resource.data.progress.size() < 300000;
    }
    // Palabreiro games, one document each, shared by the profiles that play them.
    match /games/{game} {
      allow get, list: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['game'])
        && request.resource.data.game is string
        && request.resource.data.game.size() < 100000;
    }
  }
}
